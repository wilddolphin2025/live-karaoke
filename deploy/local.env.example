# Copy to deploy/local.env (gitignored) and fill in. Read by deploy/render.sh, deploy.sh and make-cert.sh.
# Host dir with the HF cache (ASR model, gguf/ for TranslateGemma, torch/ for Demucs), mounted at /models.
MODEL_CACHE_DIR=/home/YOUR_USER/.cache/huggingface
# Host dir for vocal-removal job files, shared by the ASR and separator pods.
JOBS_CACHE_DIR=/home/YOUR_USER/.cache/parakeet-jobs
# Name of the k8s TLS secret used by the Traefik ingresses (asr-ingress.yaml, headlamp-ingress.yaml).
TLS_SECRET_NAME=asr-tls
# Only used by deploy/make-cert.sh (cert subject/SANs) and for your clients' server URL.
ASR_HOSTNAME=YOUR_HOSTNAME
ASR_HOST_IP=YOUR_SERVER_IP
