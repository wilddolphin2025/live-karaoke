# Copy to extension/local.env (gitignored). Both are optional: without them the first run opens Settings.
LK_SERVER=http://YOUR_SERVER_IP:30800
# Extra host permissions, e.g. a TLS ingress:
#LK_EXTRA_ORIGINS=https://YOUR_HOSTNAME/*
# Public edge with a path prefix (e.g. nginx at https://YOUR_HOSTNAME/karaoke/ -> the server): add its origin here,
# set Server to https://YOUR_HOSTNAME/karaoke in Settings, and the access token from your edge (if it enforces one).
#LK_EXTRA_ORIGINS=https://YOUR_HOSTNAME/*
